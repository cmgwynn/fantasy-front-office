{
  "manifest_version": 3,
  "name": "Fantasy Front Office Side Panel",
  "short_name": "Fantasy FO",
  "version": "1.0.0",
  "description": "Keep Fantasy Front Office open in your browser's side panel while you manage your league on Sleeper, ESPN or CBS.",
  "homepage_url": "https://fantasyfo.com/side-panel",
  "minimum_chrome_version": "116",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_title": "Open Fantasy FO beside this page",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    }
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": ["sidePanel"],
  "host_permissions": ["https://fantasyfo.com/*"]
}
